# RSRecharge - Environment Variables for Production
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=your-secret-key-here

# Database (MySQL)
DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=rsrecharge_db
DB_PORT=3306

# Admin Defaults
ADMIN_EMAIL=admin@rsrecharge.in
ADMIN_PASSWORD=Admin@12345
